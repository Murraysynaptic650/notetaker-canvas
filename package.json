{
  "name": "notetaker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "iPad-optimized infinite-canvas whiteboard on tldraw, with multi-device sync, Files export, and MCP/AI collaboration.",
  "scripts": {
    "dev": "vite",
    "dev:tunnel": "vite --mode tunnel",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tldraw": "^3.9.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
