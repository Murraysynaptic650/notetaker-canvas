{
  "name": "notetaker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "iPad-optimized infinite-canvas whiteboard on tldraw, with multi-device sync, Files export, and MCP/AI collaboration.",
  "scripts": {
    "dev": "vite",
    "dev:tunnel": "vite --mode tunnel",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tldraw": "^3.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.9"
  }
}
