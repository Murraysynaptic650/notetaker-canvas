{
  "name": "notetaker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "iPad-first infinite-canvas whiteboard on tldraw, with an AI study partner that sees the board, chats about it, and draws on it.",
  "license": "MIT",
  "author": "Pratik Poudel",
  "homepage": "https://github.com/powerpratik/notetaker-canvas#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/powerpratik/notetaker-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/powerpratik/notetaker-canvas/issues"
  },
  "keywords": [
    "whiteboard",
    "infinite-canvas",
    "tldraw",
    "ipad",
    "apple-pencil",
    "pwa",
    "ai",
    "llm",
    "claude",
    "vllm",
    "handwriting",
    "study-tool"
  ],
  "scripts": {
    "dev": "vite",
    "dev:tunnel": "vite --mode tunnel",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tldraw": "^3.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
